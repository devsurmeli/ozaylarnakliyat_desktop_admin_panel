<Page x:Class="Ozaylar.Filo.Desktop.Sayfalar.PanelSayfasi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:alt="clr-namespace:Ozaylar.Filo.Desktop.Altyapi"
      Title="Panel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16">
            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="Yenile" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding YenileCommand}" />
                <TextBlock Text="{Binding Hosgeldin}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <ui:InfoBar Title="Yedekleme" Message="{Binding YedekUyari}" Severity="Warning" IsClosable="False" IsOpen="True"
                        Visibility="{Binding YedekUyari, Converter={x:Static alt:NullGorunurlukDonusturucu.Ornek}}" Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Kartlar}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Width="250" Height="112" Margin="0,0,10,10" VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{Binding Baslik}" Style="{StaticResource KartBaslik}" />
                                <TextBlock Text="{Binding Deger}" Style="{StaticResource KartDeger}" />
                                <TextBlock Text="{Binding Alt}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Uyari}" Value="True">
                                                    <Setter Property="Foreground" Value="#C42B1C" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Yoldaki / teslimdeki araçlar" Style="{StaticResource BolumBaslik}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Yoldakiler}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sefer" Binding="{Binding SeferNo}" />
                            <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" />
                            <DataGridTextColumn Header="Şoför" Binding="{Binding Sofor}" />
                            <DataGridTextColumn Header="Güzergah" Binding="{Binding Guzergah}" MinWidth="160" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding DurumAd}" />
                            <DataGridTextColumn Header="Çıkış" Binding="{Binding Cikis, StringFormat='dd.MM HH:mm'}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Kasa / banka" Style="{StaticResource BolumBaslik}" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Kasalar}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hesap" Binding="{Binding Ad}" MinWidth="160" />
                            <DataGridTextColumn Header="Tip" Binding="{Binding TipAd}" />
                            <DataGridTextColumn Header="Bakiye" Binding="{Binding Bakiye, StringFormat=N2}" />
                            <DataGridTextColumn Header="PB" Binding="{Binding PB}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Süresi dolan / yaklaşan evraklar" Style="{StaticResource BolumBaslik}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Evraklar}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="300">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuresiDoldu}" Value="True">
                                        <Setter Property="Foreground" Value="#C42B1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kime" Binding="{Binding Hedef}" />
                            <DataGridTextColumn Header="Evrak" Binding="{Binding Tur}" MinWidth="160" />
                            <DataGridTextColumn Header="Bitiş" Binding="{Binding Bitis, StringFormat=dd.MM.yyyy}" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Yaklaşan bakımlar" Style="{StaticResource BolumBaslik}" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Bakimlar}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" />
                            <DataGridTextColumn Header="Bakım" Binding="{Binding BakimAdi}" MinWidth="160" />
                            <DataGridTextColumn Header="Kalan" Binding="{Binding Durum}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
