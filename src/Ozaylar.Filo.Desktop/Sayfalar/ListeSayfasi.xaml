<Page x:Class="Ozaylar.Filo.Desktop.Sayfalar.ListeSayfasi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:k="clr-namespace:Ozaylar.Filo.Desktop.Kontroller"
      Title="{Binding Baslik}">
    <DockPanel Margin="0,0,16,12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Baslik}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
        <k:ListeGorunumu />
    </DockPanel>
</Page>
