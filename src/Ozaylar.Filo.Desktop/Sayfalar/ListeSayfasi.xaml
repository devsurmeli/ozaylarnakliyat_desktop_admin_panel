<Page x:Class="Ozaylar.Filo.Desktop.Sayfalar.ListeSayfasi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:k="clr-namespace:Ozaylar.Filo.Desktop.Kontroller"
      Title="{Binding Baslik}">
    <DockPanel Margin="0,4,20,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,16">
            <Border Width="6" Height="30" CornerRadius="3" Background="{DynamicResource HeroGradyan}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Baslik}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <k:ListeGorunumu />
    </DockPanel>
</Page>
