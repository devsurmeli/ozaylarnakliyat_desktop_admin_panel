<ui:FluentWindow x:Class="Ozaylar.Filo.Desktop.Pencereler.AnaPencere"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:k="clr-namespace:Ozaylar.Filo.Desktop.Kontroller"
                 Title="Ozaylar Filo" Width="1400" Height="860" MinWidth="1000" MinHeight="600"
                 WindowStartupLocation="CenterScreen" WindowState="Maximized"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource Zemin}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Turuncu degrade yan menü -->
        <k:YanMenu x:Name="YanMenu" Grid.Column="0" Panel.ZIndex="1" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar x:Name="Baslik" Title="" Grid.Row="0" />

            <!-- Sayfa çerçevesi (gezinme YanMenu ve Gezgin üzerinden) -->
            <k:SayfaCercevesi x:Name="Menu" Grid.Row="1" Margin="18,0,0,0" />

            <ui:SnackbarPresenter x:Name="Bildirim" Grid.Row="1" VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</ui:FluentWindow>
