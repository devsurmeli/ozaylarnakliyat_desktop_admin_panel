<ui:FluentWindow x:Class="Ozaylar.Filo.Desktop.Pencereler.GirisPenceresi"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Ozaylar Filo — Giriş" Width="860" Height="540" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
                 Background="{DynamicResource KartZemin}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Marka paneli -->
        <Border Grid.Column="0" Background="{DynamicResource HeroGradyan}" ClipToBounds="True">
            <Grid>
                <Ellipse Width="330" Height="330" Fill="White" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-150,0" />
                <Ellipse Width="220" Height="220" Fill="White" Opacity="0.06" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-90,0,0,-90" />
                <ui:SymbolIcon Symbol="VehicleTruckProfile24" FontSize="230" Foreground="White" Opacity="0.08" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,10" />
                <StackPanel Margin="36,64,30,30">
                    <Border Width="58" Height="58" CornerRadius="17" Background="#33FFFFFF" HorizontalAlignment="Left">
                        <ui:SymbolIcon Symbol="VehicleTruckProfile24" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="OZAYLAR" Foreground="White" FontSize="34" FontWeight="Black" Margin="0,22,0,0" />
                    <TextBlock Text="Filo Yönetim Sistemi" Foreground="White" Opacity="0.9" FontSize="16" />
                    <StackPanel Margin="0,32,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="White" FontSize="18" />
                            <TextBlock Text="Sefer, yakıt ve masraf takibi" Foreground="White" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="White" FontSize="18" />
                            <TextBlock Text="Şoför kasası, avans ve hakediş" Foreground="White" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="White" FontSize="18" />
                            <TextBlock Text="Kredi, leasing ve nakit akışı" Foreground="White" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="Surum" Foreground="White" Opacity="0.7" FontSize="11" Margin="36,0,0,22" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- Giriş formu -->
        <Grid Grid.Column="1">
            <ui:TitleBar Title="" ShowMaximize="False" ShowMinimize="False" VerticalAlignment="Top" />
            <StackPanel Margin="56,0,56,0" VerticalAlignment="Center">
                <TextBlock Text="Hoş geldiniz" FontSize="28" FontWeight="Bold" />
                <TextBlock x:Name="Firma" Foreground="{DynamicResource MetinIkincil}" Margin="0,4,0,28" FontSize="13.5" Text="Devam etmek için giriş yapın" />

                <TextBlock Text="Kullanıcı adı" FontWeight="SemiBold" FontSize="12.5" />
                <ui:TextBox x:Name="Kullanici" Icon="{ui:SymbolIcon Person24}" Margin="0,6,0,16" Height="40" />
                <TextBlock Text="Şifre" FontWeight="SemiBold" FontSize="12.5" />
                <ui:PasswordBox x:Name="Sifre" Icon="{ui:SymbolIcon LockClosed24}" Margin="0,6,0,16" Height="40" />

                <ui:InfoBar x:Name="Mesaj" Severity="Error" IsClosable="False" Margin="0,0,0,12" Visibility="Collapsed" />

                <ui:Button x:Name="GirisBtn" Content="Giriş yap" Icon="{ui:SymbolIcon ArrowRight24}" Appearance="Primary" IsDefault="True"
                           HorizontalAlignment="Stretch" Height="44" FontSize="14.5" FontWeight="SemiBold" CornerRadius="10" Click="Giris_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
