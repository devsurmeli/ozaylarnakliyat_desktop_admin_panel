<ui:FluentWindow x:Class="Ozaylar.Filo.Desktop.Pencereler.GirisPenceresi"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Ozaylar Filo — Giriş" Width="420" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="Ozaylar Filo" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="32,8,32,32">
            <ui:SymbolIcon Symbol="VehicleTruckProfile24" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Filo ve Sefer Yönetimi" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="Firma" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,20" />

            <TextBlock Text="Kullanıcı adı" />
            <ui:TextBox x:Name="Kullanici" Icon="{ui:SymbolIcon Person24}" Margin="0,4,0,12" />
            <TextBlock Text="Şifre" />
            <ui:PasswordBox x:Name="Sifre" Icon="{ui:SymbolIcon Key24}" Margin="0,4,0,12" />

            <ui:InfoBar x:Name="Mesaj" Severity="Error" IsClosable="False" Margin="0,0,0,12" Visibility="Collapsed" />

            <ui:Button x:Name="GirisBtn" Content="Giriş" Appearance="Primary" IsDefault="True" HorizontalAlignment="Stretch" Height="36" Click="Giris_Click" />
            <TextBlock x:Name="Surum" Opacity="0.5" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
