<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ozaylar Filo — koyu tema (kömür zemin, turuncu vurgu) -->
    <SolidColorBrush x:Key="Zemin" Color="#141210" />
    <SolidColorBrush x:Key="KartZemin" Color="#1F1B18" />
    <SolidColorBrush x:Key="KartKenar" Color="#2E2824" />
    <Color x:Key="GolgeRengi">#000000</Color>
    <SolidColorBrush x:Key="MetinBirincil" Color="#F5F5F4" />
    <SolidColorBrush x:Key="MetinIkincil" Color="#A8A29E" />
    <SolidColorBrush x:Key="Vurgu" Color="#FB923C" />
    <SolidColorBrush x:Key="VurguKoyu" Color="#FDBA74" />
    <SolidColorBrush x:Key="VurguAcik" Color="#2A1D14" />
    <SolidColorBrush x:Key="VurguSecim" Color="#4A2A12" />
    <SolidColorBrush x:Key="TabloBaslikZemin" Color="#25201C" />
    <SolidColorBrush x:Key="TabloCizgi" Color="#2B2622" />
    <SolidColorBrush x:Key="IkonZemin" Color="#3A2414" />
    <SolidColorBrush x:Key="YesilZemin" Color="#14321F" />
    <SolidColorBrush x:Key="YesilMetin" Color="#4ADE80" />
    <SolidColorBrush x:Key="KirmiziZemin" Color="#3B1515" />
    <SolidColorBrush x:Key="KirmiziMetin" Color="#F87171" />
    <SolidColorBrush x:Key="MaviZemin" Color="#0C2A3A" />
    <LinearGradientBrush x:Key="HeroGradyan" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EA580C" Offset="0" />
        <GradientStop Color="#C2410C" Offset="0.5" />
        <GradientStop Color="#7C2D12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MarkaGradyan" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB923C" Offset="0" />
        <GradientStop Color="#C2410C" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
