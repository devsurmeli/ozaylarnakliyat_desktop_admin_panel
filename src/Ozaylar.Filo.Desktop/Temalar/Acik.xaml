<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ozaylar Filo — açık tema (sıcak gri zemin, turuncu vurgu) -->
    <SolidColorBrush x:Key="Zemin" Color="#F5F2EF" />
    <SolidColorBrush x:Key="KartZemin" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KartKenar" Color="#ECE5DF" />
    <Color x:Key="GolgeRengi">#5A3A20</Color>
    <SolidColorBrush x:Key="MetinBirincil" Color="#1C1917" />
    <SolidColorBrush x:Key="MetinIkincil" Color="#78716C" />
    <SolidColorBrush x:Key="Vurgu" Color="#F97316" />
    <SolidColorBrush x:Key="VurguKoyu" Color="#C2410C" />
    <SolidColorBrush x:Key="VurguAcik" Color="#FFF3E8" />
    <SolidColorBrush x:Key="VurguSecim" Color="#FFE2C7" />
    <SolidColorBrush x:Key="TabloBaslikZemin" Color="#FBF7F3" />
    <SolidColorBrush x:Key="TabloCizgi" Color="#F1EBE6" />
    <LinearGradientBrush x:Key="IkonZemin" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF4EA" Offset="0" />
        <GradientStop Color="#FFDDBF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="YesilZemin" Color="#DCFCE7" />
    <SolidColorBrush x:Key="YesilMetin" Color="#15803D" />
    <SolidColorBrush x:Key="KirmiziZemin" Color="#FEE2E2" />
    <SolidColorBrush x:Key="KirmiziMetin" Color="#B91C1C" />
    <SolidColorBrush x:Key="MaviZemin" Color="#E0F2FE" />
    <!-- Başlık şeridi: şeftaliden yanık turuncuya 5 duraklı geçiş -->
    <LinearGradientBrush x:Key="HeroGradyan" StartPoint="0,0.15" EndPoint="1,0.85">
        <GradientStop Color="#FFA052" Offset="0" />
        <GradientStop Color="#FD9640" Offset="0.22" />
        <GradientStop Color="#F97316" Offset="0.5" />
        <GradientStop Color="#EA580C" Offset="0.78" />
        <GradientStop Color="#C2410C" Offset="1" />
    </LinearGradientBrush>
    <!-- Yan menü: yukarıda canlı turuncu, aşağı indikçe koyu kehribar/kahve -->
    <LinearGradientBrush x:Key="MenuGradyan" StartPoint="0.2,0" EndPoint="0.8,1">
        <GradientStop Color="#FF9C45" Offset="0" />
        <GradientStop Color="#F97316" Offset="0.28" />
        <GradientStop Color="#EA580C" Offset="0.58" />
        <GradientStop Color="#C2410C" Offset="0.84" />
        <GradientStop Color="#9A3412" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MarkaGradyan" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDBA74" Offset="0" />
        <GradientStop Color="#EA580C" Offset="1" />
    </LinearGradientBrush>
    <!-- Yumuşak ışık parlaması (degrade yüzeylerin üstüne) -->
    <RadialGradientBrush x:Key="Parilti" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#55FFFFFF" Offset="0" />
        <GradientStop Color="#18FFFFFF" Offset="0.55" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="SicakParilti" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#66FFD27A" Offset="0" />
        <GradientStop Color="#00FFD27A" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
